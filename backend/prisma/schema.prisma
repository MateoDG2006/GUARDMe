  @@unique([scheduleId, scheduledFor])
  @@map("reminder_occurrences")
  @@schema("guardme")
}

model Followup {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId       String    @unique @map("incident_id") @db.Uuid
  profileId        String    @map("profile_id") @db.Uuid
  closingAccountId String    @map("closing_account_id") @db.Uuid
  timeZone         String    @map("time_zone")
  status           String
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(6)
  version          Int       @default(1)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("followups")
  @@schema("guardme")
}

model FollowupQuestion {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followupId          String    @map("followup_id") @db.Uuid
  round               String
  recipientKind       String    @map("recipient_kind")
  recipientAccountIds String[]  @map("recipient_account_ids") @db.Uuid
  publishAt           DateTime  @map("publish_at") @db.Timestamptz(6)
  deadlineAt          DateTime  @map("deadline_at") @db.Timestamptz(6)
  publishedAt         DateTime? @map("published_at") @db.Timestamptz(6)
  status              String    @default("scheduled")
  version             Int       @default(1)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([followupId, round])
  @@map("followup_questions")
  @@schema("guardme")
}

model FollowupResponse {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  option     String
  at         DateTime @default(now()) @db.Timestamptz(6)
  applied    Boolean

  @@map("followup_responses")
  @@schema("guardme")
}

model LocationConsent {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId          String    @map("profile_id") @db.Uuid
  grantedByAccountId String    @map("granted_by_account_id") @db.Uuid
  grantedAt          DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByAccountId String?   @map("revoked_by_account_id") @db.Uuid
  version            Int       @default(1)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("location_consents")
  @@schema("guardme")
}

model LocationReadGrant {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consentId String    @map("consent_id") @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@map("location_read_grants")
  @@schema("guardme")
}

model LocationLatest {
  profileId      String   @id @map("profile_id") @db.Uuid
  lat            Float
  lng            Float
  accuracyM      Float    @map("accuracy_m")
  capturedAt     DateTime @map("captured_at") @db.Timestamptz(6)
  receivedAt     DateTime @map("received_at") @db.Timestamptz(6)
  installationId String   @map("installation_id") @db.Uuid

  @@map("location_latest")
  @@schema("guardme")
}

model ChangeLog {
  seq          BigInt   @id @default(autoincrement()) @map("seq")
  txid         Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()"))
  profileId    String   @map("profile_id") @db.Uuid
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Uuid
  op           String
  version      Int?
  at           DateTime @default(now()) @db.Timestamptz(6)

  @@map("change_log")
  @@schema("guardme")
}

model WorkerHeartbeat {
  workerId   String   @id @map("worker_id")
  startedAt  DateTime @map("started_at") @db.Timestamptz(6)
  lastBeatAt DateTime @map("last_beat_at") @db.Timestamptz(6)
  version    String

  @@map("worker_heartbeats")
  @@schema("guardme")
}

// Better Auth (identity). AuthAccount evita chocar con Account de dominio.

model User {
  id            String        @id @db.Uuid
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  isAnonymous   Boolean       @default(false) @map("is_anonymous")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  sessions      Session[]
  accounts      AuthAccount[]
  domainAccounts Account[]

  @@map("users")
  @@schema("identity")
}

model Session {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_idx")
  @@map("sessions")
  @@schema("identity")
}

model AuthAccount {
  id                    String    @id @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "accounts_user_idx")
  @@map("accounts")
  @@schema("identity")
}

model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("verifications")
  @@schema("identity")
}
