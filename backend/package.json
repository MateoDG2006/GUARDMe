{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:api": "nest start",
    "start:worker": "node dist/worker.main.js",
    "dev:api": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker.main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "node --import ./test/helpers/preload-better-auth.mjs node_modules/jest/bin/jest.js -c jest.config.ts",
    "test:int": "node --import ./test/helpers/preload-better-auth.mjs node_modules/jest/bin/jest.js -c jest.int.config.ts --runInBand",
    "db:start": "supabase start -x kong,auth,rest,realtime,storage,imgproxy,mailpit,studio,edge-runtime,logflare,vector,supavisor",
    "db:reset": "prisma migrate reset --force",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "cane:register": "node --env-file=.env --import tsx scripts/register-cane.ts",
    "seed:demo": "node --env-file=.env -r ts-node/register/transpile-only scripts/seed-demo-users.ts",
    "openapi:export": "node --env-file=.env -r ts-node/register/transpile-only scripts/export-openapi.ts",
    "acceptance:report": "node --env-file=.env --import tsx scripts/acceptance-report.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.2.3",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.25",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "jose": "5.10.0",
    "libphonenumber-js": "1.12.31",
    "luxon": "3.7.2",
    "nestjs-pino": "4.6.1",
    "pg-boss": "10.4.2",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/luxon": "3.7.1",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "prisma": "6.19.3",
    "source-map-support": "0.5.21",
    "supabase": "2.122.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
