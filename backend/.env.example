# Copiar a .env y completar los secretos.
NODE_ENV=development
PORT=3000

# 32+ bytes. Sin el texto "replace-with".
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL_AUTH=postgresql://guardme_auth:guardme_auth_dev@127.0.0.1:54322/postgres

DATABASE_URL_API=postgresql://guardme_api:guardme_api_dev@127.0.0.1:54322/postgres
DATABASE_URL_ONBOARDING=postgresql://guardme_onboarding:guardme_onboarding_dev@127.0.0.1:54322/postgres
DATABASE_URL_WORKER=postgresql://guardme_worker:guardme_worker_dev@127.0.0.1:54322/postgres
# Solo scripts, prisma y tests. Nunca en runtime de la API.
DATABASE_URL_MIGRATIONS=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL_INGEST=postgresql://guardme_ingest:guardme_ingest_dev@127.0.0.1:54322/postgres

# 32+ bytes aleatorios. Sin el texto "replace-with".
SECRET_PEPPER=

PUSH_PROVIDER=fake
# JSON de la cuenta de servicio. Obligatorio solo si PUSH_PROVIDER=fcm.
FCM_SERVICE_ACCOUNT_JSON=
RELAY_INTERVAL_MS=1000
ACTION_LEASE_SEC=120
ACTION_TIMEOUT_SEC=60
WORKER_CONCURRENCY=4
INCIDENT_NOTIFICATION_TTL_SEC=3600
IDEMPOTENCY_KEY_RETENTION_DAYS=7
LOCATION_ENABLED=true
# 16+ caracteres aleatorios.
HEALTH_DETAILS_TOKEN=
HEALTH_WORKER_STALE_SEC=60
HEALTH_QUEUE_STALE_SEC=60
HEALTH_PUSH_FAIL_RATIO=0.2
TELEPHONY_PROVIDER=fake
# Obligatorio solo si TELEPHONY_PROVIDER=fake. Sin el texto "replace-with".
FAKE_TELEPHONY_WEBHOOK_SECRET=
# Obligatorio solo si TELEPHONY_PROVIDER=twilio.
# Estado de llamada por polling (RECONCILE), sin StatusCallback.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Opcional: TwiML al contestar. Por defecto un Say en español.
# TWILIO_ANSWER_TWIML=

# PD-04 pendiente
PD04_CALL_RING_TIMEOUT_SEC=30
PD04_CALL_PAUSE_BETWEEN_ATTEMPTS_SEC=5
# PD-03 pendiente
PD03_HUMAN_CONFIRM_TIMEOUT_SEC=120
PD06_POSTPONE_REMINDER_SEC=300
# PD-06 pendiente
PD06_POSTPONE_COLLECTIVE_SEC=7200
PD07_FOLLOWUP_USER_WINDOW_SEC=7200
# PD-07 pendiente
PD07_FOLLOWUP_CAREGIVER_WINDOW_SEC=7200
PD07_FOLLOWUP_LAST_WINDOW_SEC=7200
# PD-08 pendiente
PD08_USER_CAN_EDIT_CAREGIVER_REMINDERS=false
OCCURRENCE_HORIZON_DAYS=7
PD08_OCCURRENCE_SNOOZE_SEC=600
# PD-10 pendiente
PD10_MAX_INCIDENT_AGE_FOR_CALLS_SEC=600
PD10_EVENT_RECEIPT_RETENTION_DAYS=30
CANE_LINK_FRESH_SEC=300
# PD-12 pendiente
PD12_CANE_PROXIMITY_PROOF_REQUIRED=false

FOLLOWUP_FIRST_LOCAL_HOUR=7
FOLLOWUP_LAST_DELAY_DAYS=3
DEFAULT_PROFILE_TIME_ZONE=America/Panama
DEFAULT_PHONE_REGION=PA

INVITATION_TTL_HOURS=72
ENROLLMENT_CODE_TTL_MIN=15
