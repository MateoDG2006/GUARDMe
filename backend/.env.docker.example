# Copiar a .env.docker y completar si hace falta.
# Los hostnames `db` son para la red interna de Compose.

NODE_ENV=development
PORT=3000

BETTER_AUTH_SECRET=local-dev-better-auth-secret-32b!
# Usá la URL que ve el celular (Tailscale/LAN), no solo localhost.
BETTER_AUTH_URL=http://100.87.186.29:3000

# Admin del contenedor (migrate/seed). Si cambiás USER/DB → down -v.
POSTGRES_USER=mateo_user_db_backend
POSTGRES_PASSWORD=change-me-admin-password
POSTGRES_DB=guardme_db_backend

# Runtime: roles RLS (migrate + seed). El admin NO va en estas URLs.
DATABASE_URL_AUTH=postgresql://guardme_auth:guardme_auth_dev@db:5432/guardme_db_backend
DATABASE_URL_API=postgresql://guardme_api:guardme_api_dev@db:5432/guardme_db_backend
DATABASE_URL_ONBOARDING=postgresql://guardme_onboarding:guardme_onboarding_dev@db:5432/guardme_db_backend
DATABASE_URL_WORKER=postgresql://guardme_worker:guardme_worker_dev@db:5432/guardme_db_backend
DATABASE_URL_INGEST=postgresql://guardme_ingest:guardme_ingest_dev@db:5432/guardme_db_backend
DATABASE_URL_MIGRATIONS=postgresql://mateo_user_db_backend:change-me-admin-password@db:5432/guardme_db_backend

SECRET_PEPPER=local-dev-secret-pepper-32b-ok!!

PUSH_PROVIDER=fake
FCM_SERVICE_ACCOUNT_JSON=
RELAY_INTERVAL_MS=1000
ACTION_LEASE_SEC=120
ACTION_TIMEOUT_SEC=60
WORKER_CONCURRENCY=4
INCIDENT_NOTIFICATION_TTL_SEC=3600
IDEMPOTENCY_KEY_RETENTION_DAYS=7
LOCATION_ENABLED=true
HEALTH_DETAILS_TOKEN=health-details-token
HEALTH_WORKER_STALE_SEC=60
HEALTH_QUEUE_STALE_SEC=60
HEALTH_PUSH_FAIL_RATIO=0.2
TELEPHONY_PROVIDER=fake
FAKE_TELEPHONY_WEBHOOK_SECRET=fake-telephony-webhook-secret
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

PD04_CALL_RING_TIMEOUT_SEC=30
PD04_CALL_PAUSE_BETWEEN_ATTEMPTS_SEC=5
PD03_HUMAN_CONFIRM_TIMEOUT_SEC=120
PD06_POSTPONE_REMINDER_SEC=300
PD06_POSTPONE_COLLECTIVE_SEC=7200
PD07_FOLLOWUP_USER_WINDOW_SEC=7200
PD07_FOLLOWUP_CAREGIVER_WINDOW_SEC=7200
PD07_FOLLOWUP_LAST_WINDOW_SEC=7200
PD08_USER_CAN_EDIT_CAREGIVER_REMINDERS=false
OCCURRENCE_HORIZON_DAYS=7
PD08_OCCURRENCE_SNOOZE_SEC=600
PD10_MAX_INCIDENT_AGE_FOR_CALLS_SEC=600
PD10_EVENT_RECEIPT_RETENTION_DAYS=30
CANE_LINK_FRESH_SEC=300
PD12_CANE_PROXIMITY_PROOF_REQUIRED=false

FOLLOWUP_FIRST_LOCAL_HOUR=7
FOLLOWUP_LAST_DELAY_DAYS=3
DEFAULT_PROFILE_TIME_ZONE=America/Panama
DEFAULT_PHONE_REGION=PA

INVITATION_TTL_HOURS=72
ENROLLMENT_CODE_TTL_MIN=15
